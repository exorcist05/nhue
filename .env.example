# nhue environment. Copy this file to .env.local, fill it in, then restart `npm run dev`.
# These values are read on the server only and are never sent to the browser.

# Paste your Gemini API key here (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Which Gemini model reads the photos. gemini-2.5-flash is the default; you can swap in any
# Gemini model that accepts images, for example gemini-2.5-pro.
GEMINI_MODEL=gemini-2.5-flash

# Set to true to see the whole flow with sample results and no API key.
MOCK_ANALYSIS=false
